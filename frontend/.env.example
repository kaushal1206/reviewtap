# ==============================================================================
# ReviewTap Frontend — Environment Configuration Inventory (Vercel)
# ==============================================================================

# Backend API Endpoint
# In production on Vercel, set this to your deployed Render backend API URL:
# Example: https://reviewtap-api.onrender.com/api
# In local development with Vite dev server proxy, default is /api
VITE_API_URL=https://reviewtap-api.onrender.com/api

# Frontend Public Application URL
# Deployed Vercel domain
VITE_APP_URL=https://reviewtap.vercel.app
