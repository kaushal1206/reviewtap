    "test:phase1": "tsx src/tests/phase1.test.ts",
    "test:phase2": "tsx src/tests/phase2.test.ts",
    "test:phase3": "tsx src/tests/phase3.test.ts",
    "test:phase4": "tsx src/tests/phase4.test.ts",
    "test:phase5": "tsx src/tests/phase5.test.ts",
    "test:phase6": "tsx src/tests/phase6.test.ts",
    "test:e2e": "tsx src/tests/master-e2e.test.ts",
    "test:all": "tsx src/tests/phase1.test.ts && tsx src/tests/phase2.test.ts && tsx src/tests/phase3.test.ts && tsx src/tests/phase4.test.ts && tsx src/tests/phase5.test.ts && tsx src/tests/phase6.test.ts && tsx src/tests/master-e2e.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
