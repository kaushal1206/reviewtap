# ==============================================================================
# ReviewTap Backend — Production & Development Environment Inventory
# ==============================================================================

# Server Network Configuration
# On Render / cloud providers, PORT is injected automatically (do not hardcode).
PORT=5000
NODE_ENV=production

# Database Connection
# Managed PostgreSQL connection string (e.g. from Render PostgreSQL / Neon / AWS RDS)
DATABASE_URL=postgresql://user:password@hostname:5432/reviewtap?schema=public&sslmode=require

# Authentication & Cryptographic Keys
# Must be secure random strings of at least 32 characters in production.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_production_jwt_secret_at_least_32_characters_long!
JWT_REFRESH_SECRET=replace_with_production_jwt_refresh_secret_at_least_32_characters!

# CORS & Allowed Origins (Vercel Frontend)
# Set to your primary deployed Vercel domain (e.g. https://reviewtap.vercel.app)
# Multiple origins may be separated by commas (e.g. https://reviewtap.vercel.app,https://app.reviewtap.com)
CLIENT_URL=https://reviewtap.vercel.app
FRONTEND_URL=https://reviewtap.vercel.app
CORS_ORIGIN=https://reviewtap.vercel.app

# Backend Public Base URL (Render Web Service)
# Public HTTPS URL of the deployed Render backend (e.g. https://reviewtap-api.onrender.com)
# Used for constructing public QR/NFC short URLs (/r/:slug, /r/nfc/:publicId)
BASE_URL=https://reviewtap-api.onrender.com

# Privacy & Telemetry Salt (GDPR / CCPA Compliant IP Anonymization)
# A secure random string used to salt SHA-256 IP address hashes.
IP_SALT=replace_with_production_random_salt_for_ip_anonymization
