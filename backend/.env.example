# ==============================================================================
# ReviewTap Backend — Environment Configuration
# ==============================================================================

# Server Network Configuration (Render assigns PORT automatically)
PORT=5000
NODE_ENV=production

# Database Connection (Render PostgreSQL)
# In Render Dashboard → reviewtap-api → Environment:
# Configure DATABASE_URL using the "Internal Database URL" from your Render PostgreSQL database.
# Format: postgresql://[user]:[password]@[hostname]/[database]?schema=public
DATABASE_URL=postgresql://user:password@hostname:5432/reviewtap?schema=public

# Authentication Secrets (generate random 32+ character strings for production)
JWT_SECRET=replace_with_production_jwt_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_production_jwt_refresh_secret_at_least_32_characters

# CORS & Frontend Allowed Origins
CLIENT_URL=https://reviewtap.vercel.app
FRONTEND_URL=https://reviewtap.vercel.app
CORS_ORIGIN=https://reviewtap.vercel.app

# Backend Public Base URL (Render Web Service)
BASE_URL=https://reviewtap-hyo1.onrender.com
